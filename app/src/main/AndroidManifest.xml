<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet for API -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <queries>
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KnowzyDemo"
        tools:targetApi="31">

        <!-- 🔥 INPUT ACTIVITY = LAUNCHER -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Knowzy.Splash">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".ui.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.RightsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.LegalHelpActivity"
            android:exported="false" />

        <activity
            android:name=".ui.HelplineActivity"
            android:exported="false" />

        <activity
            android:name=".ui.NearbyHelpActivity"
            android:exported="false" />

        <activity
            android:name=".ui.TextInputActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AiAnswerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.RecentCasesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.InputActivity"
            android:exported="false" />

        <!-- MainActivity (optional, no launcher) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Result Screen -->
        <activity
            android:name=".ui.ResultActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
